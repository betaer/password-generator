{
  "name": "password-generator",
  "version": "2.1.0",
  "private": true,
  "description": "浏览器本地运行的九模式安全随机数据生成器",
  "scripts": {
    "build:security-runtime": "node scripts/build-security-runtime.mjs",
    "build:zxcvbn": "node scripts/build-zxcvbn.mjs",
    "build:pin-risk": "node scripts/build-pin-risk-data.mjs",
    "build:security-assets": "npm run build:security-runtime && npm run build:zxcvbn && npm run build:pin-risk",
    "build:v2": "node scripts/build-v2-runtime.mjs && node scripts/build-v2-pin-risk.mjs",
    "build:v21": "node scripts/build-v21.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:v2": "node --test tests/v2/*.test.mjs",
    "test:coverage:v2": "c8 --check-coverage --branches 80 --functions 80 --lines 80 --statements 80 node --test tests/v2/*.test.mjs",
    "test:v201": "node --test tests/v201/*.test.mjs",
    "test:coverage:v201": "c8 --include='src/v201/*.mjs' --check-coverage --branches 80 --functions 80 --lines 80 --statements 80 node --test tests/v201/*.test.mjs",
    "test:v21": "node --test tests/v21/*.test.mjs",
    "test:coverage:v21": "c8 --include='src/v21/*.mjs' --check-coverage --branches 80 --functions 80 --lines 80 --statements 80 node --test tests/v21/*.test.mjs",
    "test:e2e:v21": "node scripts/verify-v21-browser.mjs",
    "verify:v21": "npm run build:v21 && npm test && npm run test:v2 && npm run test:v201 && npm run test:v21 && npm run test:coverage:v2 && npm run test:coverage:v201 && npm run test:coverage:v21 && npm run test:e2e:v21 && npm audit --audit-level=high && git diff --exit-code -- index.html index-2.1.html assets/v2.1",
    "serve": "python3 -m http.server 8765 --bind 127.0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@scure/bip39": "2.3.0",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "c8": "12.0.0",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=20"
  }
}
