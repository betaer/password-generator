{
  "name": "password-generator",
  "version": "2.0.0",
  "private": true,
  "description": "浏览器本地运行的九模式安全随机数据生成器",
  "scripts": {
    "build:security-runtime": "node scripts/build-security-runtime.mjs",
    "build:zxcvbn": "node scripts/build-zxcvbn.mjs",
    "build:pin-risk": "node scripts/build-pin-risk-data.mjs",
    "build:security-assets": "npm run build:security-runtime && npm run build:zxcvbn && npm run build:pin-risk",
    "build:v2": "node scripts/build-v2-runtime.mjs && node scripts/build-v2-pin-risk.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:v2": "node --test tests/v2/*.test.mjs",
    "test:coverage:v2": "c8 --check-coverage --branches 80 --functions 80 --lines 80 --statements 80 node --test tests/v2/*.test.mjs",
    "test:e2e:v2": "node scripts/verify-v2-browser.mjs",
    "serve": "python3 -m http.server 8765 --bind 127.0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@scure/bip39": "2.3.0",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "c8": "12.0.0",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=20"
  }
}
